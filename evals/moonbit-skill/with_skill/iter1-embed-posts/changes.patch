+// The posts of the Go blog, embedded by scripts/embed.sh into embedded.mbt,
+// which is generated and ignored by git.
+rule(name: "embed-md", command: "sh scripts/embed.sh $output $input")
+
+dev_build(
+  rule: "embed-md",
+  input: "../../go/examples/blog/posts",
+  output: "embedded.mbt",
+)
