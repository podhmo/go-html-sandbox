+///|
+// The cases of TestLists in go/pkg/tinymarkdown.
+test "lists" {
+  run([
+    ("list", "- a\n-   b  \n  - c", [List(["a", "b", "c"])]),
+    ("blank line splits lists", "- a\n\n- b", [List(["a"]), List(["b"])]),
