+///|
+test "about page" {
+  let res = @site.render("/about")
+  assert_eq(res.status, 200)
+  assert_eq(header(res, "content-type"), Some("text/html; charset=utf-8"))
+  assert_eq(header(res, "cache-control"), Some("public, max-age=60"))
+  assert_true(res.body.has_prefix("<!doctype html>\n"))
+  assert_true(res.body.contains("<title>About | blog</title>"))
+  assert_true(res.body.contains("<h1>About</h1>"))
+}
+
+///|
+test "other pages are not cached" {
+  assert_eq(header(@site.render("/"), "cache-control"), None)
+  assert_eq(header(@site.render("/about/"), "cache-control"), None)
+  assert_eq(@site.render("/about/").status, 404)
+}
