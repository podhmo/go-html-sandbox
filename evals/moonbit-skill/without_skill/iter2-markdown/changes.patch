diff --git a/moonbit/tinymarkdown/tinymarkdown.mbt b/moonbit/tinymarkdown/tinymarkdown.mbt
new file mode 100644
index 0000000..4ae4567
--- /dev/null
+++ b/moonbit/tinymarkdown/tinymarkdown.mbt
@@ -0,0 +1,306 @@
+// Package tinymarkdown parses a tiny subset of Markdown into a pure-data
+// tree. It is a port of go/pkg/tinymarkdown and gives the same trees.
+//
+// Supported: headings "#" to "#####" (which open nested sections), "- "
+// list items (which may continue on indented lines), paragraphs, "> "
+// quotes, "|" tables, and code blocks fenced by exactly "```". Anything else
+// is treated as paragraph text.
+// Block parsing keeps inline syntax as text; `inlines` splits out code spans
+// and links on request. See docs/sketch/ja/blog.md.
+//
+// Positions are UTF-16 code units. Every character the syntax looks at is
+// ASCII, so they cut strings at the same places as Go's byte offsets.
+
+///|
+/// Document is the root of a parsed document. Blocks before the first
+/// heading are its direct children.
+pub(all) struct Document {
+  children : Array[Block]
+} derive(Eq, Debug)
+
+///|
+/// Block is a block-level node.
+pub(all) enum Block {
+  /// A heading together with everything up to the next heading of the same
+  /// or a shallower level. `level` is 1..5.
+  Section(level~ : Int32, title~ : String, children~ : Array[Block])
+  /// A run of consecutive non-blank lines, joined with "\n".
+  Paragraph(String)
+  /// A run of consecutive "- " lines, holding the text after "- ". Indented
+  /// lines that follow an item continue it, joined with "\n".
+  List(Array[String])
+  /// A run of consecutive lines starting with ">". The text after ">" and
+  /// one optional space is parsed again as a document, so a quote may hold
+  /// paragraphs, lists, code blocks, and nested quotes.
+  Quote(Array[Block])
+  /// A run of consecutive lines starting with "|": a header row, a delimiter
+  /// row such as "| --- | --- |", and body rows. Cells hold their text with
+  /// surrounding spaces trimmed and "\|" unescaped to "|"; inline syntax is
+  /// kept as text, as in Paragraph. Every row has as many cells as the
+  /// header: missing cells are empty and extra ones are dropped. Column
+  /// alignment (":---:") is accepted in the delimiter row but ignored.
+  Table(header~ : Array[String], rows~ : Array[Array[String]])
+  /// The verbatim content between "```" fences, lines joined with "\n".
+  /// Text after the opening fence (a language name) is ignored.
+  CodeBlock(String)
+} derive(Eq, Debug)
+
+///|
+let fence : String = "```"
+
+///|
+/// max_level is the deepest heading level recognized.
+let max_level : Int32 = 5
+
+///|
+/// spaces are the characters Go's unicode.IsSpace accepts, so that `trim`
+/// removes what strings.TrimSpace does in the Go version.
+let spaces : String = "\t\n\u{0B}\u{0C}\r \u{85}\u{A0}\u{1680}\u{2000}\u{2001}\u{2002}\u{2003}\u{2004}\u{2005}\u{2006}\u{2007}\u{2008}\u{2009}\u{200A}\u{2028}\u{2029}\u{202F}\u{205F}\u{3000}"
+
+///|
+/// trim is strings.TrimSpace.
+fn trim(s : StringView) -> String {
+  s.trim(chars=spaces).to_owned()
+}
+
+///|
+/// Flat is a block from `scan`, with headings kept as markers until `nest`
+/// builds sections.
+priv enum Flat {
+  Heading(Int32, String)
+  Block(Block)
+}
+
+///|
+/// parse parses src. It never fails: lines it does not understand become
+/// paragraph text.
+pub fn parse(src : String) -> Document {
+  let (children, _) = nest(scan(src), 0, 0)
+  { children, }
+}
+
+///|
+/// scan splits src into a flat list of blocks, with headings as markers.
+fn scan(src : String) -> Array[Flat] {
+  let out : Array[Flat] = []
+  let para : Array[String] = []
+  let items : Array[String] = []
+  let quote : Array[String] = []
+  let table : Array[String] = []
+  fn flush() {
+    if para.length() > 0 {
+      out.push(Block(Paragraph(para.join("\n"))))
+      para.clear()
+    }
+    if items.length() > 0 {
+      out.push(Block(List(items.copy())))
+      items.clear()
+    }
+    if quote.length() > 0 {
+      out.push(Block(Quote(parse(quote.join("\n")).children)))
+      quote.clear()
+    }
+    if table.length() > 0 {
+      match parse_table(table) {
+        Some(t) => out.push(Block(t))
+        None => out.push(Block(Paragraph(table.join("\n"))))
+      }
+      table.clear()
+    }
+  }
+
+  let code : Array[String] = []
+  let mut in_code = false
+  for raw in src.split("\n") {
+    let line = (match raw.strip_suffix("\r") {
+      Some(l) => l
+      None => raw
+    }).to_owned()
+    let trimmed = trim(line)
+    if in_code {
+      if trimmed == fence {
+        out.push(Block(CodeBlock(code.join("\n"))))
+        code.clear()
+        in_code = false
+      } else {
+        code.push(line)
+      }
+      continue
+    }
+    if trimmed.has_prefix(fence) {
+      flush()
+      in_code = true
+    } else if trimmed == "" {
+      flush()
+    } else if is_heading(trimmed) {
+      flush()
+      out.push(parse_heading(trimmed))
+    } else if trimmed.has_prefix("|") {
+      if para.length() > 0 || items.length() > 0 || quote.length() > 0 {
+        flush()
+      }
+      table.push(trimmed)
+    } else if trimmed.has_prefix(">") {
+      if para.length() > 0 || items.length() > 0 || table.length() > 0 {
+        flush()
+      }
+      let gt = line.find(">").unwrap()
+      let rest = line[gt + 1:]
+      quote.push(
+        (match rest.strip_prefix(" ") {
+          Some(r) => r
+          None => rest
+        }).to_owned(),
+      )
+    } else if trimmed.has_prefix("- ") {
+      if para.length() > 0 || quote.length() > 0 || table.length() > 0 {
+        flush()
+      }
+      items.push(trim(trimmed[2:]))
+    } else if items.length() > 0 &&
+      line != trimmed &&
+      (line[0] == ' ' || line[0] == '\t') {
+      // An indented line continues the item above it.
+      let last = items.length() - 1
+      items[last] = items[last] + "\n" + trimmed
+    } else {
+      if items.length() > 0 || quote.length() > 0 || table.length() > 0 {
+        flush()
+      }
+      para.push(trimmed)
+    }
+  }
+  if in_code {
+    // An unclosed fence runs to the end of the document.
+    out.push(Block(CodeBlock(code.join("\n"))))
+  }
+  flush()
+  out
+}
+
+///|
+/// parse_table parses the lines of a table. It fails, leaving the lines to
+/// be a paragraph, unless the second line is a delimiter row with as many
+/// cells as the header.
+fn parse_table(lines : Array[String]) -> Block? {
+  if lines.length() < 2 {
+    return None
+  }
+  let header = cells(lines[0])
+  let delim = cells(lines[1])
+  if delim.length() != header.length() {
+    return None
+  }
+  for c in delim {
+    if !is_delimiter(c) {
+      return None
+    }
+  }
+  let rows : Array[Array[String]] = []
+  for i in 2..<lines.length() {
+    let row = cells(lines[i])
+    while row.length() > header.length() {
+      row.pop() |> ignore
+    }
+    while row.length() < header.length() {
+      row.push("")
+    }
+    rows.push(row)
+  }
+  Some(Table(header~, rows~))
+}
+
+///|
+/// cells splits a row such as "| a | b |" at unescaped "|". The leading "|"
+/// is required by scan; the trailing one is optional.
+fn cells(row : String) -> Array[String] {
+  let line = match row.strip_prefix("|") {
+    Some(l) => l.to_owned()
+    None => row
+  }
+  let out : Array[String] = []
+  let b = StringBuilder()
+  // Text is copied in runs between the "|" and "\|" that end them, so that
+  // a surrogate pair is never cut.
+  let mut run = 0
+  let mut i = 0
+  while i < line.length() {
+    if line[i] == '\\' && i + 1 < line.length() && line[i + 1] == '|' {
+      b.write_view(line[run:i])
+      b.write_char('|')
+      i += 2
+      run = i
+    } else if line[i] == '|' {
+      b.write_view(line[run:i])
+      out.push(trim(b.to_string()))
+      b.reset()
+      i += 1
+      run = i
+    } else {
+      i += 1
+    }
+  }
+  b.write_view(line[run:])
+  let rest = trim(b.to_string())
+  if rest != "" {
+    out.push(rest)
+  }
+  out
+}
+
+///|
+/// is_delimiter reports whether c is a delimiter cell: "---", ":---",
+/// ":---:", or "---:", with at least one "-".
+fn is_delimiter(cell : String) -> Bool {
+  let mut c = cell[:]
+  if c.has_prefix(":") {
+    c = c[1:]
+  }
+  if c.has_suffix(":") {
+    c = c[:c.length() - 1]
+  }
+  c != "" && c.trim(chars="-") == ""
+}
+
+///|
+fn is_heading(line : String) -> Bool {
+  let mut n = 0
+  while n < line.length() && line[n] == '#' {
+    n += 1
+  }
+  n < line.length() && 1 <= n && n <= max_level && line[n] == ' '
+}
+
+///|
+fn parse_heading(line : String) -> Flat {
+  let n = line.find(" ").unwrap()
+  Heading(n, trim(line[n:]))
+}
+
+///|
+/// nest turns headings in flat into nested sections. It consumes blocks from
+/// flat[i:] until a heading at or above level, returning the children and
+/// the index where it stopped.
+fn nest(
+  flat : Array[Flat],
+  start : Int32,
+  level : Int32,
+) -> (Array[Block], Int32) {
+  let out : Array[Block] = []
+  let mut i = start
+  while i < flat.length() {
+    match flat[i] {
+      Block(b) => {
+        out.push(b)
+        i += 1
+      }
+      Heading(l, _) if l <= level => break
+      Heading(l, title) => {
+        let (children, next) = nest(flat, i + 1, l)
+        out.push(Section(level=l, title~, children~))
+        i = next
+      }
+    }
+  }
+  (out, i)
+}
