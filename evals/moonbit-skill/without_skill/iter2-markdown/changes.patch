+// The cases of go/pkg/tinymarkdown/tinymarkdown_test.go, with the same
+// names and the same expected trees.
+
+///|
+fn check(src : String, want : Array[@tinymarkdown.Block]) -> Unit raise {
+  assert_eq(@tinymarkdown.parse(src), { children: want, })
+}
+
+// TestSectionsAndParagraphs
+
+///|
+test "sections/empty" {
+  check("", [])
+}
+
+///|
+test "sections/blank lines only" {
+  check("\n  \n\n", [])
+}
+
+///|
+test "sections/paragraph" {
+  check("hello", [Paragraph("hello")])
+}
+
+///|
+test "sections/lines join into one paragraph" {
+  check("a\nb\r\n  c  ", [Paragraph("a\nb\nc")])
+}
+
+///|
+test "sections/blank line separates paragraphs" {
+  check("a\n\nb", [Paragraph("a"), Paragraph("b")])
+}
+
+///|
+test "sections/paragraph before first heading stays at root" {
+  check("intro\n# Title\nbody", [
+    Paragraph("intro"),
+    Section(level=1, title="Title", children=[Paragraph("body")]),
+  ])
+}
+
+///|
+test "sections/heading ends a paragraph without a blank line" {
+  check("a\n## H", [Paragraph("a"), Section(level=2, title="H", children=[])])
+}
+
+///|
+test "sections/nested sections" {
+  check("# A\na\n## B\nb\n### C\nc\n## D\n# E", [
+    Section(level=1, title="A", children=[
+      Paragraph("a"),
+      Section(level=2, title="B", children=[
+        Paragraph("b"),
+        Section(level=3, title="C", children=[Paragraph("c")]),
+      ]),
+      Section(level=2, title="D", children=[]),
+    ]),
+    Section(level=1, title="E", children=[]),
+  ])
+}
+
+///|
+test "sections/level jump nests under the shallower heading" {
+  check("# A\n### C\n## B", [
+    Section(level=1, title="A", children=[
+      Section(level=3, title="C", children=[]),
+      Section(level=2, title="B", children=[]),
+    ]),
+  ])
+}
+
+///|
+test "sections/heading title is trimmed" {
+  check("#   spaced   ", [Section(level=1, title="spaced", children=[])])
+}
+
+///|
+test "sections/#### and ##### nest" {
+  check("#### D\nd\n##### E\ne\n#### F", [
+    Section(level=4, title="D", children=[
+      Paragraph("d"),
+      Section(level=5, title="E", children=[Paragraph("e")]),
+    ]),
+    Section(level=4, title="F", children=[]),
+  ])
+}
+
+///|
+test "sections/###### is not a heading" {
+  check("###### deep", [Paragraph("###### deep")])
+}
+
+///|
+test "sections/# without a space is not a heading" {
+  check("#tag", [Paragraph("#tag")])
+}
+
+///|
+test "sections/bare # is not a heading" {
+  check("#", [Paragraph("#")])
+}
+
+///|
+test "sections/inline syntax is kept as is" {
+  check("**bold** [link](/x)", [Paragraph("**bold** [link](/x)")])
+}
+
+// TestLists
+
+///|
+test "lists/list" {
+  check("- a\n-   b  \n  - c", [List(["a", "b", "c"])])
+}
+
+///|
+test "lists/blank line splits lists" {
+  check("- a\n\n- b", [List(["a"]), List(["b"])])
+}
+
+///|
+test "lists/list after paragraph without a blank line" {
+  check("intro\n- a\n- b", [Paragraph("intro"), List(["a", "b"])])
+}
+
+///|
+test "lists/paragraph after list without a blank line" {
+  check("- a\nafter", [List(["a"]), Paragraph("after")])
+}
+
+///|
+test "lists/indented lines continue an item" {
+  check("- a\n  more\n\tand more\n- b\n  b2", [
+    List(["a\nmore\nand more", "b\nb2"]),
+  ])
+}
+
+///|
+test "lists/indented line after a paragraph stays in the paragraph" {
+  check("p\n  q", [Paragraph("p\nq")])
+}
+
+///|
+test "lists/blank line ends the continuation" {
+  check("- a\n\n  b", [List(["a"]), Paragraph("b")])
+}
+
+///|
+test "lists/dash without a space is paragraph text" {
+  check("-a\n--", [Paragraph("-a\n--")])
+}
+
+///|
+test "lists/list inside a section" {
+  check("# A\n- x\n## B\n- y", [
+    Section(level=1, title="A", children=[
+      List(["x"]),
+      Section(level=2, title="B", children=[List(["y"])]),
+    ]),
+  ])
+}
+
+// TestCodeBlocks
+
+///|
+test "code blocks/code block" {
+  check("```\nfmt.Println(1)\n```", [CodeBlock("fmt.Println(1)")])
+}
+
+///|
+test "code blocks/language name is ignored" {
+  check("```go\nx := 1\n```", [CodeBlock("x := 1")])
+}
+
+///|
+test "code blocks/contents are kept verbatim" {
+  check("```\n# not a heading\n- not a list\n\n\tindented  \n```", [
+    CodeBlock("# not a heading\n- not a list\n\n\tindented  "),
+  ])
+}
+
+///|
+test "code blocks/empty code block" {
+  check("```\n```", [CodeBlock("")])
+}
+
+///|
+test "code blocks/closing fence may have surrounding spaces" {
+  check("```\na\n  ```  \nafter", [CodeBlock("a"), Paragraph("after")])
+}
+
+///|
+test "code blocks/closing fence must be bare" {
+  check("```\n```go\n```", [CodeBlock("```go")])
+}
+
+///|
+test "code blocks/CRLF line endings" {
+  check("```\r\na\r\n```\r\n", [CodeBlock("a")])
+}
+
+///|
+test "code blocks/unclosed fence runs to EOF" {
+  check("```\na\n\n# b", [CodeBlock("a\n\n# b")])
+}
+
+///|
+test "code blocks/fence ends a paragraph and a list" {
+  check("p\n```\nc\n```\n- a\n```\nd\n```", [
+    Paragraph("p"),
+    CodeBlock("c"),
+    List(["a"]),
+    CodeBlock("d"),
+  ])
+}
+
+///|
+test "code blocks/code block inside a section" {
+  check("# A\n```\n## x\n```", [
+    Section(level=1, title="A", children=[CodeBlock("## x")]),
+  ])
+}
+
+// TestQuotes
+
+///|
+test "quotes/quote" {
+  check("> a\n> b", [Quote([Paragraph("a\nb")])])
+}
+
+///|
+test "quotes/space after > is optional" {
+  check(">a\n  >  b", [Quote([Paragraph("a\nb")])])
+}
+
+///|
+test "quotes/bare > separates paragraphs" {
+  check("> a\n>\n> b", [Quote([Paragraph("a"), Paragraph("b")])])
+}
+
+///|
+test "quotes/blocks inside a quote" {
+  check("> - x\n>   y\n> ```\n>   code\n> ```", [
+    Quote([List(["x\ny"]), CodeBlock("  code")]),
+  ])
+}
+
+///|
+test "quotes/nested quote" {
+  check("> a\n>\n> > b", [Quote([Paragraph("a"), Quote([Paragraph("b")])])])
+}
+
+///|
+test "quotes/quote ends a paragraph and a list" {
+  check("p\n> q\n- a\n> r", [
+    Paragraph("p"),
+    Quote([Paragraph("q")]),
+    List(["a"]),
+    Quote([Paragraph("r")]),
+  ])
+}
+
+///|
+test "quotes/a line without > ends the quote" {
+  check("> q\np\n> r\n\n> s", [
+    Quote([Paragraph("q")]),
+    Paragraph("p"),
+    Quote([Paragraph("r")]),
+    Quote([Paragraph("s")]),
+  ])
+}
+
+///|
+test "quotes/quote inside a section" {
+  check("# A\n> q", [
+    Section(level=1, title="A", children=[Quote([Paragraph("q")])]),
+  ])
+}
+
+///|
+test "quotes/> inside a code block is code" {
+  check("```\n> x\n```", [CodeBlock("> x")])
+}
+
+// TestTables
+
+///|
+test "tables/table" {
+  check("| a | b |\n| --- | --- |\n| 1 | `2` |\n| 3 | 4 |", [
+    Table(header=["a", "b"], rows=[["1", "`2`"], ["3", "4"]]),
+  ])
+}
+
+///|
+test "tables/header only" {
+  check("| a |\n|---|", [Table(header=["a"], rows=[])])
+}
+
+///|
+test "tables/trailing pipe is optional" {
+  check("| a | b\n| --- | ---\n| 1 | 2", [
+    Table(header=["a", "b"], rows=[["1", "2"]]),
+  ])
+}
+
+///|
+test "tables/alignment is accepted and ignored" {
+  check("| a | b | c |\n| :-- | :-: | --: |", [
+    Table(header=["a", "b", "c"], rows=[]),
+  ])
+}
+
+///|
+test "tables/rows are padded and cut to the header" {
+  check("| a | b |\n| - | - |\n| 1 |\n| 1 | 2 | 3 |\n| | x |", [
+    Table(header=["a", "b"], rows=[["1", ""], ["1", "2"], ["", "x"]]),
+  ])
+}
+
+///|
+test "tables/escaped pipe" {
+  check("| a \\| b |\n| --- |\n| `x \\| y` |", [
+    Table(header=["a | b"], rows=[["`x | y`"]]),
+  ])
+}
+
+///|
+test "tables/no delimiter row is a paragraph" {
+  check("| a |\n| b |", [Paragraph("| a |\n| b |")])
+}
+
+///|
+test "tables/delimiter count must match" {
+  check("| a | b |\n| --- |", [Paragraph("| a | b |\n| --- |")])
+}
+
+///|
+test "tables/single line is a paragraph" {
+  check("| a |", [Paragraph("| a |")])
+}
+
+///|
+test "tables/table between paragraphs" {
+  check("intro\n| a |\n| - |\n| 1 |\nafter", [
+    Paragraph("intro"),
+    Table(header=["a"], rows=[["1"]]),
+    Paragraph("after"),
+  ])
+}
+
+///|
+test "tables/blank line splits tables" {
+  check("| a |\n| - |\n\n| b |\n| - |", [
+    Table(header=["a"], rows=[]),
+    Table(header=["b"], rows=[]),
+  ])
+}
+
+///|
+test "tables/indented rows" {
+  check("  | a |\n  | - |\n  | 1 |", [Table(header=["a"], rows=[["1"]])])
+}
+
+///|
+test "tables/table in a section and a quote" {
+  check("# T\n| a |\n| - |\n> | b |\n> | - |", [
+    Section(level=1, title="T", children=[
+      Table(header=["a"], rows=[]),
+      Quote([Table(header=["b"], rows=[])]),
+    ]),
+  ])
+}
+
+///|
+test "tables/list ends at a table" {
+  check("- x\n| a |\n| - |", [List(["x"]), Table(header=["a"], rows=[])])
+}
+
+// Not in the Go tests: non-ASCII text, which MoonBit holds as UTF-16 where
+// Go holds UTF-8. The expected trees are what the Go version returns.
+
+///|
+test "non-ASCII/ideographic space is trimmed but does not indent" {
+  check(
+    "- 項目\u{3000}\n\u{3000}続き\n# 見出し 😀\n| 😀 | b |\n| - | - |\n| `x` | [l](u) |",
+    [
+      List(["項目"]),
+      Paragraph("続き"),
+      Section(level=1, title="見出し 😀", children=[
