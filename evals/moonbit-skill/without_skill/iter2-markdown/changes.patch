@@ -0,0 +1,195 @@
+// The cases of go/pkg/tinymarkdown/inline_test.go, with the same names and
+// the same expected trees.
+
+///|
+fn check_inlines(
+  src : String,
+  want : Array[@tinymarkdown.Inline],
+) -> Unit raise {
+  assert_eq(@tinymarkdown.inlines(src), want)
+}
+
+///|
+test "inlines/empty" {
+  check_inlines("", [])
+}
+
+///|
+test "inlines/text only" {
+  check_inlines("a b", [Text("a b")])
+}
+
+///|
+test "inlines/code" {
+  check_inlines("use `go test` now", [
+    Text("use "),
+    Code("go test"),
+    Text(" now"),
+  ])
+}
+
+///|
+test "inlines/code only" {
+  check_inlines("`x`", [Code("x")])
+}
+
+///|
+test "inlines/several spans" {
+  check_inlines("`a` and `b`", [Code("a"), Text(" and "), Code("b")])
+}
+
+///|
+test "inlines/double backquotes hold a backquote" {
+  check_inlines("``a ` b``", [Code("a ` b")])
+}
+
+///|
+test "inlines/one space stripped from each end" {
+  check_inlines("`` `x` ``", [Code("`x`")])
+}
+
+///|
+test "inlines/spaces only are kept" {
+  check_inlines("` `", [Code(" ")])
+}
+
+///|
+test "inlines/space on one end is kept" {
+  check_inlines("` a`", [Code(" a")])
+}
+
+///|
+test "inlines/line break becomes a space" {
+  check_inlines("`a\nb`", [Code("a b")])
+}
+
+///|
+test "inlines/unclosed run is text" {
+  check_inlines("a ` b", [Text("a ` b")])
+}
+
+///|
+test "inlines/longer run does not close" {
+  check_inlines("`a``", [Text("`a``")])
+}
+
+///|
+test "inlines/unmatched run before a span" {
+  check_inlines("`` x `y`", [Text("`` x "), Code("y")])
+}
+
+///|
+test "inlines/empty run pair is text" {
+  check_inlines("``", [Text("``")])
+}
+
+///|
+test "inlines/html stays text" {
+  check_inlines("`<b>` <i>", [Code("<b>"), Text(" <i>")])
+}
+
+///|
+test "inlines/link" {
+  check_inlines("see [docs](docs/a.md) now", [
+    Text("see "),
+    Link(children=[Text("docs")], url="docs/a.md"),
+    Text(" now"),
+  ])
+}
+
+///|
+test "inlines/link only" {
+  check_inlines("[a](b)", [Link(children=[Text("a")], url="b")])
+}
+
+///|
+test "inlines/link with code" {
+  check_inlines("[`x` y](u)", [Link(children=[Code("x"), Text(" y")], url="u")])
+}
+
+///|
+test "inlines/bracket in code inside link" {
+  check_inlines("[`]` y](u)", [Link(children=[Code("]"), Text(" y")], url="u")])
+}
+
+///|
+test "inlines/link in code is code" {
+  check_inlines("`[a](b)`", [Code("[a](b)")])
+}
+
+///|
+test "inlines/code across link is code" {
+  check_inlines("[a `b](c)` d", [Text("[a "), Code("b](c)"), Text(" d")])
+}
+
+///|
+test "inlines/empty url" {
+  check_inlines("[a]()", [Link(children=[Text("a")], url="")])
+}
+
+///|
+test "inlines/empty text" {
+  check_inlines("[](u)", [Link(children=[], url="u")])
+}
+
+///|
+test "inlines/fragment and query" {
+  check_inlines("[a](https://x.test/p?q=1#f)", [
+    Link(children=[Text("a")], url="https://x.test/p?q=1#f"),
+  ])
+}
+
+///|
+test "inlines/no url is text" {
+  check_inlines("[a] (b)", [Text("[a] (b)")])
+}
+
+///|
+test "inlines/brackets only are text" {
+  check_inlines("[a]", [Text("[a]")])
+}
+
+///|
+test "inlines/space in url is text" {
+  check_inlines("[a](b c)", [Text("[a](b c)")])
+}
+
+///|
+test "inlines/unclosed url is text" {
+  check_inlines("[a](b", [Text("[a](b")])
+}
+
+///|
+test "inlines/nested brackets: inner link" {
+  check_inlines("[a [b](c)](d)", [
+    Text("[a "),
+    Link(children=[Text("b")], url="c"),
+    Text("](d)"),
+  ])
+}
+
+///|
+test "inlines/line break in text" {
+  check_inlines("[a\nb](u)", [Link(children=[Text("a\nb")], url="u")])
+}
+
+///|
+test "inlines/two links" {
+  check_inlines("[a](1) [b](2)", [
+    Link(children=[Text("a")], url="1"),
+    Text(" "),
+    Link(children=[Text("b")], url="2"),
+  ])
+}
+
+// Not in the Go tests: see tinymarkdown_test.mbt.
+
+///|
+test "non-ASCII/inlines" {
+  check_inlines("日本語 `😀` [リンク](/p)", [
+    Text("日本語 "),
+    Code("😀"),
+    Text(" "),
+    Link(children=[Text("リンク")], url="/p"),
+  ])
+}
