+///|
+test "every post is embedded, by file name" {
+  debug_inspect(
+    @posts.posts.map(p => p.0),
+    content=(
+      #|[
+      #|  "2026-10-14-hello.md",
+      #|  "2026-10-15-tinymarkdown.md",
+      #|  "2026-10-16-mobile-first.md",
+      #|  "2026-10-17-workers-wasm.md",
+      #|]
+    ),
+  )
+}
+
+///|
+test "posts are embedded as they are" {
+  for p in @posts.posts {
+    // Each post ends with exactly one newline, as the files do.
+    assert_true(p.1.has_suffix("\n"), msg=p.0)
+    assert_false(p.1.has_suffix("\n\n"), msg=p.0)
+  }
+  assert_true(
+    @posts.posts[0].1.has_prefix(
+      (
+        #|# Hello
+        #|
+        #|This blog is rendered by the Go standard library only.
+        #|
+      ),
+    ),
+  )
+  assert_true(
+    @posts.posts[2].1.has_prefix(
+      (
+        #|---
+        #|title: ビルドなしのモバイルファースト
+        #|
+      ),
+    ),
+  )
+}
diff --git a/moonbit/scripts/embed-posts.sh b/moonbit/scripts/embed-posts.sh
new file mode 100644
index 0000000..d57d8d8
--- /dev/null
+++ b/moonbit/scripts/embed-posts.sh
@@ -0,0 +1,50 @@
+#!/bin/sh
+# embed-posts.sh writes a MoonBit source holding the Go blog's posts, as
+# (file name, content) pairs sorted by file name, the names being those of
+# Go's posts.FS (e.g. "2026-10-14-hello.md").
+#
+# MoonBit has no go:embed, and moon's pre-build cannot take a glob (a
+# directory as input reruns only when files are added or removed, not
+# edited), so make runs this script before every moon command instead; see
+# ../Makefile.
+#
+# Usage: sh scripts/embed-posts.sh POSTS_DIR OUTPUT
+set -eu
+
+dir=$1
+out=$2
+tmp=$out.tmp
+export LC_ALL=C
+
+{
+  printf '// Generated by scripts/embed-posts.sh from %s/*.md; do not edit.\n' "$dir"
+  i=0
+  for f in "$dir"/*.md; do
+    [ -f "$f" ] || continue
+    printf '\n///|\nlet post_%d : String =\n' "$i"
+    # Each line becomes a #| line of a multiline string, which needs no
+    # escaping. The lines are joined with "\n", so a final newline in the
+    # file needs one more, empty, line.
+    awk '{ print "  #|" $0 }' "$f"
+    if [ ! -s "$f" ] || [ "$(tail -c 1 "$f" | od -An -c | tr -d ' ')" = '\n' ]; then
+      printf '  #|\n'
+    fi
+    i=$((i + 1))
+  done
+  printf '\n///|\n/// posts holds every post as (file name, content), sorted by file name.\n'
+  printf 'pub let posts : Array[(String, String)] = [\n'
+  i=0
+  for f in "$dir"/*.md; do
+    [ -f "$f" ] || continue
+    name=$(basename "$f" | sed 's/[\\"]/\\&/g')
+    printf '  ("%s", post_%d),\n' "$name" "$i"
+    i=$((i + 1))
+  done
+  printf ']\n'
+} > "$tmp"
+# Leave an unchanged output alone, so that moon does not rebuild for it.
+if cmp -s "$tmp" "$out"; then
+  rm "$tmp"
+else
+  mv "$tmp" "$out"
+fi
