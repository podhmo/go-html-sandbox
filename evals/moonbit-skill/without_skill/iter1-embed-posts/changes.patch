+/// render answers the request for path: the top page, listing the embedded
+/// posts by file name, for "/", and a 404 page saying nothing is there for
+/// any other path.
 pub fn render(path : String) -> Response {
   let sb = StringBuilder()
   match path {
     "/" => {
       page(sb, "blog", fn(sb) {
-        sb.write_string("<h1>blog</h1><p>Rendered with MoonBit.</p>")
+        sb.write_string("<h1>blog</h1><p>Rendered with MoonBit.</p><ul>")
