diff --git a/moonbit/el/node.mbt b/moonbit/el/node.mbt
new file mode 100644
index 0000000..4aebc6a
--- /dev/null
+++ b/moonbit/el/node.mbt
@@ -0,0 +1,62 @@
+// Package el builds HTML as plain data and renders it with a Renderer,
+// ported from go/pkg/el.
+//
+// Nodes carry no rendering logic: they are values compared with ==.
+// Element and attribute names are distinct types (Tag and AttrName) so that
+// passing one where the other is expected fails to compile.
+
+///|
+/// Tag is an element name such as "div".
+pub(all) struct Tag(String) derive(Eq, Debug)
+
+///|
+/// AttrName is an attribute name such as "class".
+pub(all) struct AttrName(String) derive(Eq, Debug)
+
+///|
+/// Node is a piece of an HTML document.
+///
+/// - `Text` is text content, escaped when rendered as HTML.
+/// - `Raw` is trusted markup written as is. Never put user input in it.
+/// - `Element` is an element. `Attr` and `BoolAttr` children go into the
+///   start tag; every other child becomes content.
+/// - `Attr` is an attribute with a value, such as class="x".
+/// - `BoolAttr` is an attribute without a value, such as hidden.
+pub(all) enum Node {
+  Text(String)
+  Raw(String)
+  Element(Tag, Array[Node])
+  Attr(AttrName, String)
+  BoolAttr(AttrName)
+} derive(Eq, Debug)
+
+///|
+/// el returns an element with the given children.
+pub fn el(name : Tag, children : Array[Node]) -> Node {
+  Element(name, children)
+}
+
+///|
+/// attr returns an attribute with a value.
+pub fn attr(key : AttrName, val : String) -> Node {
+  Attr(key, val)
+}
+
+///|
+/// bool_attr returns an attribute without a value.
+pub fn bool_attr(key : AttrName) -> Node {
+  BoolAttr(key)
+}
+
+///|
+/// text returns a text node. The text is escaped when rendered as HTML.
+pub fn text(s : String) -> Node {
+  Text(s)
+}
+
+///|
+/// raw returns a node written without escaping. Use it only for trusted,
+/// static strings such as embedded CSS.
+pub fn raw(s : String) -> Node {
+  Raw(s)
+}
diff --git a/moonbit/el/node_test.mbt b/moonbit/el/node_test.mbt
new file mode 100644
index 0000000..69c615c
--- /dev/null
+++ b/moonbit/el/node_test.mbt
@@ -0,0 +1,41 @@
+// Ported from go/pkg/el/node_test.go.
+
+///|
+test "constructors" {
+  let cases : Array[(String, @el.Node, @el.Node)] = [
+    ("text", @el.text("hi"), Text("hi")),
+    ("raw", @el.raw("<b>"), Raw("<b>")),
+    ("attr", @el.attr(@el.class, "x"), Attr(AttrName("class"), "x")),
+    (
+      "bool attr",
+      @el.bool_attr(AttrName("hidden")),
+      BoolAttr(AttrName("hidden")),
+    ),
+    ("empty element", @el.el(@el.br, []), Element(Tag("br"), [])),
+    (
+      "nested element",
+      @el.el(@el.div, [@el.attr(@el.id, "a"), @el.el(@el.p, [@el.text("hi")])]),
+      Element(Tag("div"), [
+        Attr(AttrName("id"), "a"),
+        Element(Tag("p"), [Text("hi")]),
+      ]),
+    ),
+    (
+      "dynamic names",
+      @el.el(Tag("my-widget"), [@el.attr(AttrName("data-id"), "1")]),
+      Element(Tag("my-widget"), [Attr(AttrName("data-id"), "1")]),
+    ),
+  ]
+  for c in cases {
+    let (name, got, want) = c
+    assert_eq(got, want, msg=name)
+  }
+}
+
+///|
+test "leaf nodes are comparable" {
+  let s = "a"
+  assert_true(@el.text(s) == Text("a"))
+  let href = "/"
+  assert_true(@el.attr(@el.href, href) == Attr(AttrName("href"), "/"))
+}
diff --git a/moonbit/el/render.mbt b/moonbit/el/render.mbt
new file mode 100644
index 0000000..c78c701
--- /dev/null
+++ b/moonbit/el/render.mbt
@@ -0,0 +1,253 @@
+///|
+/// Renderer writes nodes in some output format. `render` dispatches each
+/// node to the matching method; `element` implementations call `render`
+/// again for their children.
+pub(open) trait Renderer {
+  fn text(Self, &Logger, String) -> Unit
+  fn raw(Self, &Logger, String) -> Unit
+  fn element(Self, &Logger, Tag, Array[Node]) -> Unit
+  fn attr(Self, &Logger, AttrName, String) -> Unit
+  fn bool_attr(Self, &Logger, AttrName) -> Unit
+}
+
+///|
+/// render writes n to w using r. This is the only place that matches on
+/// node kinds.
+pub fn[R : Renderer] render(w : &Logger, n : Node, r : R) -> Unit {
+  match n {
+    Text(s) => r.text(w, s)
+    Raw(s) => r.raw(w, s)
+    Element(name, children) => r.element(w, name, children)
+    Attr(name, value) => r.attr(w, name, value)
+    BoolAttr(name) => r.bool_attr(w, name)
+  }
+}
+
+///|
+/// to_html returns n rendered by HtmlRenderer.
+pub fn to_html(n : Node) -> String {
+  let sb = StringBuilder()
+  render(sb, n, HtmlRenderer::{ })
+  sb.to_string()
+}
+
+///|
+/// to_plain returns n rendered by a new PlainRenderer.
+pub fn to_plain(n : Node) -> String {
+  let sb = StringBuilder()
+  render(sb, n, PlainRenderer::new())
+  sb.to_string()
+}
+
+///|
+/// is_attr reports whether n belongs in a start tag rather than in content.
+fn is_attr(n : Node) -> Bool {
+  n is (Attr(_) | BoolAttr(_))
+}
+
+///|
+/// is_void reports whether elements named name have no content and no end
+/// tag.
+fn is_void(name : Tag) -> Bool {
+  match name.0 {
+    "area"
+    | "base"
+    | "br"
+    | "col"
+    | "embed"
+    | "hr"
+    | "img"
+    | "input"
+    | "link"
+    | "meta"
+    | "source"
+    | "track"
+    | "wbr" => true
+    _ => false
+  }
+}
+
+///|
+/// escape writes s to w with the characters special in HTML replaced by
+/// entities, the same as Go's html.EscapeString.
+pub fn escape(w : &Logger, s : String) -> Unit {
+  for c in s {
+    match c {
+      '<' => w.write_string("&lt;")
+      '>' => w.write_string("&gt;")
+      '&' => w.write_string("&amp;")
+      '\'' => w.write_string("&#39;")
+      '"' => w.write_string("&#34;")
+      _ => w.write_char(c)
+    }
+  }
+}
+
+///|
+/// HtmlRenderer writes HTML5.
+pub(all) struct HtmlRenderer {}
+
+///|
+pub impl Renderer for HtmlRenderer with fn text(_, w, s) {
+  escape(w, s)
+}
+
+///|
+pub impl Renderer for HtmlRenderer with fn raw(_, w, s) {
+  w.write_string(s)
+}
+
+///|
+pub impl Renderer for HtmlRenderer with fn element(self, w, name, children) {
+  w.write_string("<")
+  w.write_string(name.0)
+  for c in children {
+    if is_attr(c) {
+      render(w, c, self)
+    }
+  }
+  w.write_string(">")
+  if is_void(name) {
+    return
+  }
+  for c in children {
+    if !is_attr(c) {
+      render(w, c, self)
+    }
+  }
+  w.write_string("</")
+  w.write_string(name.0)
+  w.write_string(">")
+}
+
+///|
+pub impl Renderer for HtmlRenderer with fn attr(_, w, name, value) {
+  w.write_string(" ")
+  w.write_string(name.0)
+  w.write_string("=\"")
+  escape(w, value)
+  w.write_string("\"")
+}
+
+///|
+pub impl Renderer for HtmlRenderer with fn bool_attr(_, w, name) {
+  w.write_string(" ")
+  w.write_string(name.0)
+}
+
+///|
+/// PlainRenderer writes only text content, dropping tags, attributes, and
+/// raw markup. Text is not escaped. Block-level elements (paragraphs,
+/// headings, list items, ...) start and end on their own line, so the
+/// output reads like the page. Useful for debugging and for tests that
+/// check what a page says.
+///
+/// It remembers the last character it wrote so that a line break never
+/// makes a blank line or a leading newline, so use a new one for each
+/// output.
+pub struct PlainRenderer {
+  mut last : Char? // None until something is written
+}
+
+///|
+pub fn PlainRenderer::new() -> PlainRenderer {
+  { last: None, }
+}
+
+///|
+fn PlainRenderer::write(self : PlainRenderer, w : &Logger, s : String) -> Unit {
+  if s.is_empty() {
+    return
+  }
+  w.write_string(s)
+  self.last = s.rev_iter().next()
+}
+
+///|
+fn PlainRenderer::break_line(self : PlainRenderer, w : &Logger) -> Unit {
+  match self.last {
+    None | Some('\n') => ()
+    Some(_) => self.write(w, "\n")
+  }
+}
+
+///|
+pub impl Renderer for PlainRenderer with fn text(self, w, s) {
+  self.write(w, s)
+}
+
+///|
+pub impl Renderer for PlainRenderer with fn raw(_, _, _) {
+
+}
+
+///|
+pub impl Renderer for PlainRenderer with fn element(self, w, name, children) {
+  let block = is_block(name)
+  if block {
+    self.break_line(w)
+  }
+  for c in children {
+    render(w, c, self)
+  }
+  if block {
+    self.break_line(w)
+  }
+}
+
+///|
+pub impl Renderer for PlainRenderer with fn attr(_, _, _, _) {
+
+}
+
+///|
+pub impl Renderer for PlainRenderer with fn bool_attr(_, _, _) {
+
+}
+
+///|
+/// is_block reports whether PlainRenderer puts elements named name on
+/// their own lines.
+fn is_block(name : Tag) -> Bool {
+  match name.0 {
+    "address"
+    | "article"
+    | "aside"
+    | "blockquote"
+    | "body"
+    | "br"
+    | "dd"
+    | "details"
+    | "div"
+    | "dl"
+    | "dt"
+    | "figcaption"
+    | "figure"
+    | "footer"
+    | "form"
+    | "h1"
+    | "h2"
+    | "h3"
+    | "h4"
+    | "h5"
+    | "h6"
+    | "head"
+    | "header"
+    | "hgroup"
+    | "hr"
+    | "html"
+    | "li"
+    | "main"
+    | "nav"
+    | "ol"
+    | "p"
+    | "pre"
+    | "section"
+    | "summary"
+    | "table"
+    | "title"
+    | "tr"
+    | "ul" => true
+    _ => false
+  }
+}
diff --git a/moonbit/el/render_test.mbt b/moonbit/el/render_test.mbt
