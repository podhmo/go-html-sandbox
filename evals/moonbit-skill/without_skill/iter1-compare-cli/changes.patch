diff --git a/moonbit/compare/cmd/main.mbt b/moonbit/compare/cmd/main.mbt
new file mode 100644
index 0000000..47cdad6
--- /dev/null
+++ b/moonbit/compare/cmd/main.mbt
@@ -0,0 +1,60 @@
+///|
+/// fetch gets url without following redirects, so a redirect is compared
+/// as its own response.
+async fn fetch(url : String) -> @compare.Fetched {
+  let (response, body) = @http.get(url) catch {
+    e => return Failed(e.to_string())
+  }
+  let content_type = response.headers
+    .get(@http.CaseInsensitiveString("content-type"))
+    .unwrap_or("")
+  let body = body.text() catch {
+    _ => "(not UTF-8: \{body.binary().length()} bytes)"
+  }
+  Ok(status=response.code, content_type~, body~)
+}
+
+///|
+/// main fetches each path from the Go blog and the MoonBit Worker and
+/// reports which responses differ in status, Content-Type, or body. It
+/// fails when any path differs, so scripts can check the exit status.
+async fn main {
+  let matches = @argparse.Command(
+    "compare",
+    about="Compare the Go blog and the MoonBit Worker path by path.",
+    positionals=[
+      PositionArg(
+        "go",
+        about="base URL of the Go blog, e.g. http://localhost:8080",
+        num_args=@argparse.ValueRange::single(),
+      ),
+      PositionArg(
+        "moonbit",
+        about="base URL of the MoonBit Worker, e.g. http://localhost:8787",
+        num_args=@argparse.ValueRange::single(),
+      ),
+      PositionArg(
+        "paths",
+        about="paths to compare (default: /, a post, a document, /docs/, /favicon.svg, and a missing path)",
+        num_args=ValueRange(lower=0),
+      ),
+    ],
+  ).parse()
+  guard matches.values is { "go": [go_base], "moonbit": [moonbit_base], .. } else {
+    fail("two base URLs are required")
+  }
+  let paths = match matches.values {
+    { "paths": [_, ..] as paths, .. } => paths
+    _ => @compare.default_paths
+  }
+  let results = []
+  for path in paths {
+    let go = fetch(@compare.join_url(go_base, path))
+    let moonbit = fetch(@compare.join_url(moonbit_base, path))
+    results.push(@compare.compare(path, go~, go_base~, moonbit~, moonbit_base~))
+  }
+  @stdio.stdout.write(@compare.report(results))
+  if results.iter().any(fn(r) { !r.differences.is_empty() }) {
+    fail("some paths differ")
+  }
+}
