diff --git a/moonbit/compare/compare.mbt b/moonbit/compare/compare.mbt
new file mode 100644
index 0000000..9c73f85
--- /dev/null
+++ b/moonbit/compare/compare.mbt
@@ -0,0 +1,154 @@
+///|
+/// default_paths are the paths compared when none are given: the top page,
+/// a post, a document, the document list, the favicon, and a path with
+/// nothing at it.
+pub let default_paths : Array[String] = [
+  "/", "/posts/hello", "/docs/ja/design", "/docs/", "/favicon.svg", "/no-such-page",
+]
+
+///|
+/// Fetched is what one server answered for a path, or why it could not.
+pub(all) enum Fetched {
+  Ok(status~ : Int32, content_type~ : String, body~ : String)
+  Failed(String)
+}
+
+///|
+/// Result is the comparison of one path across the two servers. differences
+/// is empty when they match.
+pub(all) struct Result {
+  path : String
+  differences : Array[String]
+}
+
+///|
+/// join_url appends path to base, dropping a trailing slash from base so
+/// "http://localhost:8080/" and "http://localhost:8080" work alike.
+pub fn join_url(base : String, path : String) -> String {
+  let base = if base.has_suffix("/") {
+    base[:base.length() - 1].to_owned()
+  } else {
+    base
+  }
+  base + path
+}
+
+///|
+/// normalize replaces base in body with a placeholder, so absolute URLs
+/// built from each server's own origin (the OGP tags) do not count as
+/// differences.
+pub fn normalize(body : String, base : String) -> String {
+  let base = if base.has_suffix("/") {
+    base[:base.length() - 1].to_owned()
+  } else {
+    base
+  }
+  if base == "" {
+    body
+  } else {
+    body.replace_all(old=base, new="{BASE_URL}")
+  }
+}
+
+///|
+/// compare reports how go and moonbit differ for path. Bodies are compared
+/// after normalize with each side's base URL.
+pub fn compare(
+  path : String,
+  go~ : Fetched,
+  go_base~ : String,
+  moonbit~ : Fetched,
+  moonbit_base~ : String,
+) -> Result {
+  let differences = []
+  match (go, moonbit) {
+    (Failed(e), Failed(f)) => {
+      differences.push("go: request failed: \{e}")
+      differences.push("moonbit: request failed: \{f}")
+    }
+    (Failed(e), _) => differences.push("go: request failed: \{e}")
+    (_, Failed(e)) => differences.push("moonbit: request failed: \{e}")
+    (
+      Ok(status=gs, content_type=gc, body=gb),
+      Ok(status=ms, content_type=mc, body=mb),
+    ) => {
+      if gs != ms {
+        differences.push("status: go \{gs}, moonbit \{ms}")
+      }
+      if gc != mc {
+        differences.push(
+          "content-type: go \{gc.escape()}, moonbit \{mc.escape()}",
+        )
+      }
+      if body_diff(normalize(gb, go_base), normalize(mb, moonbit_base))
+        is Some(d) {
+        differences.push(d)
+      }
+    }
+  }
+  { path, differences, }
+}
+
+///|
+/// body_diff describes where a and b first differ, by line and column, or
+/// None when they are equal. Each side is shown from a little before the
+/// difference, since pages are often long single lines.
+pub fn body_diff(a : String, b : String) -> String? {
+  if a == b {
+    return None
+  }
+  let al = a.split("\n").map(fn(s) { s.to_owned() }).to_array()
+  let bl = b.split("\n").map(fn(s) { s.to_owned() }).to_array()
+  let mut i = 0
+  while i < al.length() && i < bl.length() && al[i] == bl[i] {
+    i += 1
+  }
+  let ac = if i < al.length() { al[i].to_array() } else { [] }
+  let bc = if i < bl.length() { bl[i].to_array() } else { [] }
+  let mut j = 0
+  while j < ac.length() && j < bc.length() && ac[j] == bc[j] {
+    j += 1
+  }
+  let excerpt = fn(lines : Array[String], chars : Array[Char]) {
+    if i >= lines.length() {
+      return "(end of body)"
+    }
+    let from = if j > 20 { j - 20 } else { 0 }
+    let to = if from + 100 < chars.length() {
+      from + 100
+    } else {
+      chars.length()
+    }
+    let s = String::from_array(chars[from:to]).escape()
+    (if from > 0 { "..." } else { "" }) +
+    s +
+    (if to < chars.length() { "..." } else { "" })
+  }
+  Some(
+    (
+      $|body: \{a.length()} vs \{b.length()} chars, \{al.length()} vs \{bl.length()} lines; first difference at line \{i + 1}, column \{j + 1}
+      $|      go:      \{excerpt(al, ac)}
+      $|      moonbit: \{excerpt(bl, bc)}
+    ),
+  )
+}
+
+///|
+/// report formats results, one block per path, ending with a summary line.
+pub fn report(results : Array[Result]) -> String {
+  let sb = StringBuilder()
+  let mut differing = 0
+  for r in results {
+    if r.differences.is_empty() {
+      sb.write_string("same  \{r.path}\n")
+    } else {
+      differing += 1
+      sb.write_string("DIFF  \{r.path}\n")
+      for d in r.differences {
+        sb.write_string("      \{d}\n")
+      }
+    }
+  }
+  sb.write_string("\{differing} of \{results.length()} paths differ\n")
+  sb.to_string()
+}
diff --git a/moonbit/compare/compare_test.mbt b/moonbit/compare/compare_test.mbt
new file mode 100644
index 0000000..67f2b75
--- /dev/null
+++ b/moonbit/compare/compare_test.mbt
@@ -0,0 +1,98 @@
+///|
+test "join_url drops a trailing slash from the base" {
+  inspect(
+    @compare.join_url("http://localhost:8080/", "/docs/"),
+    content="http://localhost:8080/docs/",
+  )
+  inspect(
+    @compare.join_url("http://localhost:8080", "/"),
+    content="http://localhost:8080/",
+  )
+}
+
+///|
+test "normalize hides each server's own origin" {
+  inspect(
+    @compare.normalize(
+      "<meta content=\"http://localhost:8080/posts/hello\">", "http://localhost:8080/",
+    ),
+    content="<meta content=\"{BASE_URL}/posts/hello\">",
+  )
+}
+
+///|
+test "matching responses have no differences" {
+  let go : @compare.Fetched = Ok(
+    status=200,
+    content_type="text/html; charset=utf-8",
+    body="<a href=\"http://a/\">",
+  )
+  let moonbit : @compare.Fetched = Ok(
+    status=200,
+    content_type="text/html; charset=utf-8",
+    body="<a href=\"http://b/\">",
+  )
+  let r = @compare.compare(
+    "/",
+    go~,
+    go_base="http://a",
+    moonbit~,
+    moonbit_base="http://b",
+  )
+  assert_true(r.differences.is_empty())
+}
+
+///|
+test "report names what differs" {
+  let go : @compare.Fetched = Ok(
+    status=200,
+    content_type="text/html; charset=utf-8",
+    body="<h1>blog</h1>\n<p>a</p>",
+  )
+  let moonbit : @compare.Fetched = Ok(
+    status=404,
+    content_type="text/plain",
+    body="<h1>blog</h1>\n<p>b</p>\n",
+  )
+  let results = [
+    @compare.compare("/", go~, go_base="", moonbit~, moonbit_base=""),
+    @compare.compare(
+      "/x",
+      go=Failed("connection refused"),
+      go_base="",
+      moonbit~,
+      moonbit_base="",
+    ),
+    @compare.compare("/same", go~, go_base="", moonbit=go, moonbit_base=""),
+  ]
+  inspect(
+    @compare.report(results),
+    content=(
+      #|DIFF  /
+      #|      status: go 200, moonbit 404
+      #|      content-type: go "text/html; charset=utf-8", moonbit "text/plain"
+      #|      body: 22 vs 23 chars, 2 vs 3 lines; first difference at line 2, column 4
+      #|      go:      "<p>a</p>"
+      #|      moonbit: "<p>b</p>"
+      #|DIFF  /x
+      #|      go: request failed: connection refused
+      #|same  /same
+      #|2 of 3 paths differ
+      #|
+    ),
+  )
+}
+
+///|
+test "body_diff shows a long line from near the difference" {
+  let head = "<p>" + "x".repeat(30)
+  inspect(
+    @compare.body_diff(head + "a</p>", head + "b</p>\n").unwrap(),
+    content=(
+      #|body: 38 vs 39 chars, 1 vs 2 lines; first difference at line 1, column 34
+      #|      go:      ..."xxxxxxxxxxxxxxxxxxxxa</p>"
+      #|      moonbit: ..."xxxxxxxxxxxxxxxxxxxxb</p>"
+    ),
+  )
+  assert_true(@compare.body_diff("same", "same") is None)
+}
