// Element names. Add a line here to support a new element; for a one-off
// dynamic name, build it directly: Tag("my-widget").
//
// When an element and an attribute share a name, the element keeps the
// bare name and the attribute gets an _attr suffix (title / title_attr).
// Attributes whose names are MoonBit keywords get the suffix too
// (defer_attr, type_attr).

///|
pub let a : Tag = Tag("a")

///|
pub let article : Tag = Tag("article")

///|
pub let blockquote : Tag = Tag("blockquote")

///|
pub let body : Tag = Tag("body")

///|
pub let br : Tag = Tag("br")

///|
pub let code : Tag = Tag("code")

///|
pub let div : Tag = Tag("div")

///|
pub let footer : Tag = Tag("footer")

///|
pub let h1 : Tag = Tag("h1")

///|
pub let h2 : Tag = Tag("h2")

///|
pub let h3 : Tag = Tag("h3")

///|
pub let h4 : Tag = Tag("h4")

///|
pub let h5 : Tag = Tag("h5")

///|
pub let head : Tag = Tag("head")

///|
pub let header : Tag = Tag("header")

///|
pub let hgroup : Tag = Tag("hgroup")

///|
pub let hr : Tag = Tag("hr")

///|
pub let html : Tag = Tag("html")

///|
pub let img : Tag = Tag("img")

///|
pub let input : Tag = Tag("input")

///|
pub let li : Tag = Tag("li")

///|
pub let link : Tag = Tag("link")

///|
pub let main : Tag = Tag("main")

///|
