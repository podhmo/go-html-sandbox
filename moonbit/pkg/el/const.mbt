///|
pub let td : Tag = Tag("td")

///|
pub let th : Tag = Tag("th")

///|
pub let thead : Tag = Tag("thead")

///|
pub let time : Tag = Tag("time")

///|
pub let title : Tag = Tag("title")

///|
pub let tr : Tag = Tag("tr")

///|
pub let ul : Tag = Tag("ul")

// Attribute names. For a one-off dynamic name, build it directly:
// AttrName("data-id").

///|
pub let alt : AttrName = AttrName("alt")

///|
pub let defer_attr : AttrName = AttrName("defer")

///|
pub let charset : AttrName = AttrName("charset")

///|
pub let class : AttrName = AttrName("class")

///|
pub let content : AttrName = AttrName("content")

///|
pub let datetime : AttrName = AttrName("datetime")

///|
pub let download : AttrName = AttrName("download")

///|
pub let href : AttrName = AttrName("href")

///|
pub let id : AttrName = AttrName("id")

///|
pub let lang : AttrName = AttrName("lang")

///|
pub let name : AttrName = AttrName("name")

///|
pub let property : AttrName = AttrName("property")

///|
pub let rel : AttrName = AttrName("rel")

///|
pub let src : AttrName = AttrName("src")

///|
pub let title_attr : AttrName = AttrName("title")

///|
pub let type_attr : AttrName = AttrName("type")

///|
pub let value : AttrName = AttrName("value")
