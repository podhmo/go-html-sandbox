// Cloudflare Workers config for the MoonBit blog; see ../README.md.
// `npx wrangler dev` builds the Wasm and serves on http://localhost:8787.
{
  "name": "blog-moonbit",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "cd .. && make build && mkdir -p workers/build && cp _build/wasm-gc/release/build/worker/worker.wasm workers/build/app.wasm",
    // Rebuild when the MoonBit sources or the embedded files change under
    // `wrangler dev`. Not ../posts, ../repodocs, or ../assets: the build
    // writes embedded.mbt there.
    "watch_dir": [
      "../el", "../picoel", "../tinymarkdown", "../tinyfrontmatter", "../site", "../worker",
      "../../go/examples/blog/posts", "../../go/examples/blog/internal/site", "../../docs"
    ]
  },
  "vars": {
    // Public origin for OGP tags, like the Go blog's -base-url. This is the
    // deployed URL, so `wrangler dev` also writes it into OGP tags.
    "BASE_URL": "https://blog-moonbit.ababjam61.workers.dev"
  },
  "env": {
    // The same Worker deployed as blog, in place of the Go blog
    // (`make deploy-blog`). The Go blog's ../../go/examples/blog/workers
    // also deploys as blog, so the last deploy wins.
    "blog": {
      // Without this, wrangler would name it blog-moonbit-blog.
      "name": "blog",
      // vars are not inherited by environments.
      "vars": {
        "BASE_URL": "https://blog.ababjam61.workers.dev"
      }
    }
  }
}
