// Cloudflare Workers config for the MoonBit blog; see ../README.md.
// `npx wrangler dev` builds the Wasm and serves on http://localhost:8787.
{
  "name": "blog-moonbit",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "cd .. && make build && mkdir -p workers/build && cp _build/wasm-gc/release/build/worker/worker.wasm workers/build/app.wasm",
    // Rebuild when the MoonBit sources or the embedded posts and documents
    // change under `wrangler dev`. Not ../posts or ../repodocs: the build
    // writes embedded.mbt there.
    "watch_dir": ["../site", "../worker", "../../go/examples/blog/posts", "../../docs"]
  }
}
