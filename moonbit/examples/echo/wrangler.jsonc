// Cloudflare Workers config for the echo example, for `make dev-echo` only
// (it is not deployed).
{
  "name": "moonbit-echo",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "cd ../.. && moon build --target wasm-gc --release examples/echo",
    "watch_dir": ["../../pkg/http", "."]
  },
  "vars": { "GREETING": "hi" }
}
