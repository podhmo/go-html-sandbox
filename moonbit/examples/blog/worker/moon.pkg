import {
  "podhmo/blog/examples/blog/site",
  "podhmo/blog/pkg/http",
  "podhmo/blog/pkg/http/wasm",
}

// Only wasm-gc, as http/wasm, whose inline Wasm does not compile on
// native, where the comparison CLI in compare/cmd is built.

supported_targets = "+wasm-gc"

options(
  link: {
    "wasm-gc": { "exports": [ "serve" ], "export-memory-name": "memory" },
  },
)
