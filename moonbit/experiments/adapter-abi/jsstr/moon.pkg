import {
  "podhmo/html-sandbox/examples/blog/site",
  "podhmo/html-sandbox/pkg/http",
}

supported_targets = "+wasm-gc"

options(
  link: {
    "wasm-gc": {
      "exports": [ "serve" ],
      "use-js-builtin-string": true,
      "imported-string-constants": "wasm:js/string-constants",
    },
  },
)
