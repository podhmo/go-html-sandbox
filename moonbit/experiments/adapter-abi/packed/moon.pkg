import {
  "podhmo/html-sandbox/examples/blog/site",
  "podhmo/html-sandbox/pkg/http",
}

// Only wasm-gc: the host imports do not compile on native, where the
// comparison CLI in compare/cmd is built.

supported_targets = "+wasm-gc"

options(
  link: {
    "wasm-gc": {
      "exports": [ "path_push", "set_base_url", "set_query", "serve" ],
    },
  },
)
