import {
  "podhmo/blog/site",
  "moonbitlang/core/encoding/utf8",
}

// Only wasm-gc: the inline Wasm that reads and writes the linear memory
// does not compile on native, where the comparison CLI in compare/cmd is
// built.

supported_targets = "+wasm-gc"

options(
  link: {
    "wasm-gc": { "exports": [ "serve" ], "export-memory-name": "memory" },
  },
)
