// Cloudflare Workers config for the blog on Hono; see ../../README.md.
// The Vite plugin reads it: `npm run dev` in ../.. serves the Worker on
// http://localhost:5173. The Go and MoonBit blogs deploy as blog, so this
// deploys as blog-ts, beside them.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "blog-ts",
  "main": "./src/app.tsx",
  "compatibility_date": "2026-10-01",
  "vars": {
    // Public origin for OGP tags, like the Go blog's -base-url.
    "BASE_URL": "https://blog-ts.podhmo.workers.dev"
  }
}
