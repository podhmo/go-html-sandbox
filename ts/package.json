{
  "name": "html-sandbox-ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite examples/blog",
    "build": "vite build examples/blog",
    "preview": "npm run build && vite preview examples/blog",
    "deploy": "npm run build && cd examples/blog && wrangler deploy",
    "test": "vitest run",
    "check": "vitest run && tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
