{
  "name": "html-sandbox-ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "embed": "node examples/blog/scripts/embed.ts",
    "dev": "wrangler dev --config examples/blog/wrangler.jsonc",
    "deploy": "wrangler deploy --config examples/blog/wrangler.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run embed && npm run typecheck && npm test"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
