// Cloudflare Workers config for this module; see README.md.
// `npx wrangler dev` builds with TinyGo and serves on http://localhost:8787.
// `npx wrangler dev --env go` builds with the standard Go toolchain instead.
// Both deploy as the same Worker, blog, so the last deploy wins.
{
  "name": "blog",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "(cd .. && go generate ./repodocs) && go run github.com/syumai/workers-go/cmd/workers-assets-gen -mode tinygo && tinygo build -o ./build/app.wasm -target wasm -no-debug ."
  },
  "vars": {
    // Public origin for OGP tags, like -base-url. This is the deployed URL,
    // so `wrangler dev` also writes it into OGP tags.
    "BASE_URL": "https://blog.ababjam61.workers.dev"
  },
  "env": {
    // The same Worker built with the standard Go toolchain (GOOS=js
    // GOARCH=wasm), for when TinyGo is not installed. The binary is about
    // four times as large; see docs/sketch/ja/blog-tinygo-workers.md.
    "go": {
      // Without this, wrangler would name it blog-go.
      "name": "blog",
      "build": {
        "command": "(cd .. && go generate ./repodocs) && go run github.com/syumai/workers-go/cmd/workers-assets-gen -mode go && GOOS=js GOARCH=wasm go build -o ./build/app.wasm ."
      },
      // vars are not inherited by environments.
      "vars": {
        "BASE_URL": "https://blog.ababjam61.workers.dev"
      }
    }
  }
}
